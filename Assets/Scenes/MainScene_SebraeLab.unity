  m_Script: {fileID: 11500000, guid: 8b827efb8a3a48228ad92209459ec01e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LabQuest.TourQuizManager
  m_Stages:
  - stage: 0
    instructions: "Bem-vindo! Pegue o tablet sobre a mesa da recep\xE7\xE3o (bot\xE3o
      Grip) para come\xE7ar a visita."
    narration: {fileID: 0}
    enableOnEnter: []
    disableOnEnter: []
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - stage: 1
    instructions: "Teleporte liberado! Mire o marcador na \xE1rea de Coworking com
      o anal\xF3gico e solte para se teleportar."
    narration: {fileID: 0}
    enableOnEnter:
    - {fileID: 748575494}
    - {fileID: 1218209298}
    disableOnEnter: []
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - stage: 2
    instructions: "Agora v\xE1 at\xE9 a bancada da AMAGAMES e pegue o trof\xE9u para
      ouvir sobre a comunidade de jogos."
    narration: {fileID: 0}
    enableOnEnter:
    - {fileID: 2066939293}
    disableOnEnter: []
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - stage: 3
    instructions: "Siga para a Arena e aperte o bot\xE3o vermelho sobre a mesa de
      madeira para ligar o tel\xE3o."
    narration: {fileID: 0}
    enableOnEnter:
    - {fileID: 1194617415}
    disableOnEnter: []
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - stage: 4
    instructions: "Hora do quiz! Responda \xE0s perguntas no painel usando o raio
      do controle."
    narration: {fileID: 0}
    enableOnEnter: []
    disableOnEnter: []
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - stage: 5
    instructions: "Parab\xE9ns, voc\xEA acertou o quiz! V\xE1 at\xE9 o terminal perto
      da entrada e valide o seu crach\xE1."
    narration: {fileID: 0}
    enableOnEnter:
    - {fileID: 1856539267}
    disableOnEnter: []
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - stage: 6
    instructions: "Tour conclu\xEDdo! Voc\xEA agora \xE9 um Inovador do SEBRAE Lab."
    narration: {fileID: 0}
    enableOnEnter:
    - {fileID: 949198588}
    - {fileID: 131504484}
    disableOnEnter: []
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  m_InstructionsText: {fileID: 1081039974}
